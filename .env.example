# Supabase pooled Postgres connection string.
# Use the transaction pooler URL for serverless deployments.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require"

# Optional: set to a fixed timezone for daily question rollover logic.
APP_TIMEZONE="America/New_York"
